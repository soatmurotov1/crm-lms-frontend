# API manzili. Bo'sh qoldirilsa client.js o'zi tanlaydi:
#   http  (vite dev)  -> http://localhost:4040/api
#   https (production) -> https://abrorbek.me/api
# Majburan biror manzilga ulanish kerak bo'lsa, mos qatorni ochib qo'y.
# DIQQAT: abrorbek.me'dagi backend eski build - unda organizations, plans,
# subscriptions, support, notifications, exams route'lari yo'q. Shu satr ochiq
# turganda lokal ishlaganingda ham so'rovlar o'sha eski serverga ketadi va
# "Cannot GET /api/..." xatosini beradi. Serverni yangilaguningcha yopiq tur.
VITE_API_BASE_URL=https://abrorbek.me/api
# VITE_API_BASE_URL=http://localhost:4041/api

# Shu raqam bilan kirgan foydalanuvchi admin panelga tushadi.
# Qolgan hamma student panelga tushadi. Backenddagi ADMIN_PHONE bilan bir xil bo'lsin.
VITE_ADMIN_PHONE=+998507703050
