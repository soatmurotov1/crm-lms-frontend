# Backend LMS API (/api/v2) manzili, oxirida "/" yo'q.
# Lokal ishlab chiqish: backend `npm run start:dev` (PORT=4040).
VITE_API_BASE_URL="http://localhost:4040/api/v2"

# `npm run api:types` / `npm run api:check` uchun OpenAPI manzili (faqat Node,
# brauzerga tushmaydi — VITE_ prefiksi ishlatilmaydi). Lokal backend Swagger JSON:
OPENAPI_URL="http://localhost:4040/api-json"

# Ixtiyoriy demo hisob. Berilsa, bosh sahifadagi "Demoni ochish" tugmasi
# /login?demo=1 ni ochadi va email/parolni oldindan to'ldiradi. Bo'sh bo'lsa,
# tugma bosh sahifadagi interaktiv namunaga olib boradi.
VITE_DEMO_EMAIL=""
VITE_DEMO_PASSWORD=""
